# Telegram bot settings. Copy to .env.bot (ignored by git) on the server.

# Token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Chat ids allowed to use the bot, comma-separated. Send /start to the bot to learn yours.
TELEGRAM_ALLOWED_CHAT_IDS=

# Same Fogo Cruzado login as the web app
FOGOCRUZADO_EMAIL=
FOGOCRUZADO_PASSWORD=

# Seconds between Fogo Cruzado checks (minimum 60)
POLL_SECONDS=120
