# Copy to .env.local (ignored by git) and fill in. These stay on the server:
# no VITE_ prefix, so they never reach the browser bundle.

# Fogo Cruzado API login — request access at https://api.fogocruzado.org.br/
FOGOCRUZADO_EMAIL=
FOGOCRUZADO_PASSWORD=

# Set to 1 to serve fictional sample shootings while you wait for access.
# Ignored once the credentials above are set.
FOGOCRUZADO_DEMO=
