{
  "name": "sentinela",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bot": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.bot bot/main.ts",
    "build:android": "tsc -b && vite build --mode android && cap sync android",
    "apk": "npm run build:android && cd android && gradlew assembleDebug",
    "api": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.bot server/api-server.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@turf/turf": "^7.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
